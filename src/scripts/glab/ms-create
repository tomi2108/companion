dependencies=("axios@0.21.4")

if [ "$type" == "dao" ]
then
  dependencies=("sequelize")
fi

if [ "$type" == "bau" ]
then
  dependencies=("mongoose")
fi

if [ "$type" == "bau" ]
then
  sed -i '1 i\import "../configuration/db";' "$server"
fi

replace_name(){
  sed -i "s/{{name}}/movistarempresas-$name/g" "$full_path"/"$1"
}

replace_description(){
  sed -i "s/{{description}}/$description/g" "$full_path"/"$1"
}

git add .
git commit -m "initial commit"
glab repo create -g mimovistarempresas/backend --name "movistarempresas-$name" --defaultBranch master --remoteName origin
git push

{
  "openshift": {
    "mock_secrets": [
      "apiinternosmock"
    ],
    "namespace_prefix": "movistar-empresas",
    "project": "empresas",
    "product": "mimovistarempresas",
    "mf_host_template": "{{env}}-mimovistarempresas.movistar.com.ar",
    "deployments": {
      "exclude": [
        "app-shell"
      ],
      "secrets": [
        "elasticsearch"
      ],
      "configmapENV": {
        "ELK_LOGS_DEBUG": "off",
        "ELK_LOGS": "on",
        "STDOUT_LOGS": "on"
      },
      "autoscaling": {
        "enabled": false,
        "minReplicas": 1,
        "maxReplicas": 3
      },
      "resources": {
        "limits": {
          "cpu": "40m",
          "memory": "128Mi"
        },
        "requests": {
          "cpu": "15m",
          "memory": "64Mi"
        }
      },
      "readinessProbe": {
        "enabled": true
      },
      "route": {
        "enabled": true
      },
      "app": {
        "secrets": [],
        "readinessProbe": {
          "enabled": false
        },
        "route": {
          "enabled": false
        }
      },
      "movistar-empresas-cert": {
        "autoscaling": {
          "enabled": true,
          "minReplicas": 3,
          "maxReplicas": 6
        },
        "resources": {
          "limits": {
            "cpu": "100m",
            "memory": "256Mi"
          },
          "requests": {
            "cpu": "30m",
            "memory": "256Mi"
          }
        },
        "configmapENV": {
          "STDOUT_LOGS": "off"
        }
      }
    }
  },
  "gitlab": {
    "default_reviewer": "tosanche",
    "repos": {
      "backend": 6058,
      "frontend": 6057,
      "despliegues": 6069,
      "argocd": 431,
      "threescale": 4825,
      "vault": 6070
    }
  },
  "vault": {
    "project": "empresas"
  },
  "dynatrace": {
    "modulo": "MIMOVISTAREMPRESAS"
  },
  "threescale": {
    "products": {
      "movistar-empresas-dev": "api_dev_mimovistarempresas",
      "movistar-empresas-int": "api_int_mimovistarempresas",
      "movistar-empresas-cert": "api_cert_mimovistarempresas"
